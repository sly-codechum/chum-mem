{
  "name": "@chum-mem/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.tsx",
  "types": "./src/index.tsx",
  "scripts": {
    "build": "tsx scripts/build-client.ts --minify && tsc -p tsconfig.json",
    "build:client": "tsx scripts/build-client.ts",
    "dev": "tsx scripts/build-client.ts && tsx src/index.tsx",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm exec vitest run --passWithNoTests",
    "lint": "pnpm exec eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@chum-mem/contracts": "workspace:*",
    "@chum-mem/db": "workspace:*",
    "@types/three": "^0.183.1",
    "d3-force-3d": "^3.0.6",
    "esbuild": "^0.28.0",
    "express": "^5.1.0",
    "react": "^19.0.0",
    "three": "^0.183.2"
  }
}
