# syntax=docker/dockerfile:1.7

ARG RUST_VERSION=1
ARG DEBIAN_VERSION=bookworm
ARG APP_UID=10001

FROM rust:${RUST_VERSION}-slim-${DEBIAN_VERSION} AS build
WORKDIR /app

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      lld \
      libopenblas-dev \
      perl \
      pkg-config \
    && rm -rf /var/lib/apt/lists/*

ENV RUSTFLAGS="-C link-arg=-fuse-ld=lld"

RUN --mount=type=bind,source=Cargo.toml,target=/app/Cargo.toml,readonly \
    --mount=type=bind,source=Cargo.lock,target=/app/Cargo.lock,readonly \
    --mount=type=bind,source=.cargo,target=/app/.cargo,readonly \
    --mount=type=bind,source=infra,target=/app/infra,readonly \
    --mount=type=bind,source=rust,target=/app/rust,readonly \
    --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/app/target \
    <<'EOF'
set -eux
cargo build --release --locked -p chum-mem-api -p chum-mem-worker
install -D /app/target/release/chum-mem-api /out/chum-mem-api
install -D /app/target/release/chum-mem-worker /out/chum-mem-worker
EOF

FROM debian:${DEBIAN_VERSION}-slim AS rust-runtime
ARG APP_UID

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      dumb-init \
      libopenblas0-pthread \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid "${APP_UID}" --user-group --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin appuser \
    && mkdir -p /data/turbovec \
    && chown -R appuser:appuser /data

WORKDIR /app
USER appuser
ENTRYPOINT ["dumb-init", "--"]

FROM rust-runtime AS rust-api
COPY --from=build /out/chum-mem-api /bin/chum-mem-api
EXPOSE 65301
CMD ["/bin/chum-mem-api"]

FROM rust-runtime AS rust-worker
COPY --from=build /out/chum-mem-worker /bin/chum-mem-worker
CMD ["/bin/chum-mem-worker"]
