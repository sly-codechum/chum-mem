{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "CHUM_PROVIDER=codex CHUM_SCRIPTS_DIR=\"${CODEX_HOME:-$HOME/.codex}/chum-memory-scripts\" bash \"${CODEX_HOME:-$HOME/.codex}/chum-memory-scripts/hook-dispatch.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "CHUM_PROVIDER=codex CHUM_SCRIPTS_DIR=\"${CODEX_HOME:-$HOME/.codex}/chum-memory-scripts\" bash \"${CODEX_HOME:-$HOME/.codex}/chum-memory-scripts/hook-dispatch.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "CHUM_PROVIDER=codex CHUM_SCRIPTS_DIR=\"${CODEX_HOME:-$HOME/.codex}/chum-memory-scripts\" bash \"${CODEX_HOME:-$HOME/.codex}/chum-memory-scripts/hook-dispatch.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "CHUM_PROVIDER=codex CHUM_SCRIPTS_DIR=\"${CODEX_HOME:-$HOME/.codex}/chum-memory-scripts\" bash \"${CODEX_HOME:-$HOME/.codex}/chum-memory-scripts/hook-dispatch.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "CHUM_PROVIDER=codex CHUM_SCRIPTS_DIR=\"${CODEX_HOME:-$HOME/.codex}/chum-memory-scripts\" bash \"${CODEX_HOME:-$HOME/.codex}/chum-memory-scripts/hook-dispatch.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
