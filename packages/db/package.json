{
  "name": "@chum-mem/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "migrate": "tsx src/cli-migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm exec vitest run --passWithNoTests",
    "lint": "pnpm exec eslint src --ext .ts"
  },
  "dependencies": {
    "@chum-mem/contracts": "workspace:*",
    "postgres": "^3.4.5",
    "zod": "^3.24.2"
  }
}
